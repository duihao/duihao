{
  "schemaVersion": 2,
  "id": "composer",
  "name": "Composer",
  "category": "tool",
  "kind": "cli",
  "description": "PHP 依赖管理器。按需执行（跑完即退），无守护无端口。entry 借用 php 运行时，调用前需已安装 php。",
  "homepage": "https://getcomposer.org",
  "license": "MIT",

  "versions": [
    {
      "version": "2.8.4",
      "source": "url",
      "platforms": {
        "windows-amd64": {
          "url": "https://getcomposer.org/download/2.8.4/composer.phar",
          "sha256": "",
          "size": 0
        }
      }
    }
  ],

  "requires": {
    "runlib": [],
    "host": []
  },

  "bin": { "windows-amd64": "composer.phar" },
  "entry": ["{runtime:php:8.2.29}/php.exe", "composer.phar"],
  "cwd": "{dir}",

  "lifecycle": {
    "install": [
      { "action": "mkdir", "path": "{dir}/cache" }
    ]
  }
}

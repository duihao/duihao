{
  "schemaVersion": 2,
  "id": "nginx",
  "name": "Nginx",
  "category": "web",
  "kind": "process",
  "description": "高性能 Web 服务器 / 反向代理。实例默认提供静态站点，站点编排（M4）将引用其 http 端口。",
  "homepage": "https://nginx.org",
  "license": "BSD-2-Clause",
  "versions": [
    {
      "version": "1.15.11",
      "source": "url",
      "platforms": {
        "windows-amd64": {
          "url": "https://nginx.org/download/nginx-1.15.11.zip",
          "urls": ["https://mirrors.huaweicloud.com/nginx/nginx-1.15.11.zip"],
          "sha256": "",
          "size": 0
        }
      }
    }
  ],
  "requires": {
    "runlib": [],
    "host": []
  },
  "bin": {
    "windows-amd64": "nginx.exe"
  },
  "ports": [
    {
      "name": "http",
      "pool": "web",
      "default": 80
    }
  ],
  "workers": 0,
  "lifecycle": {
    "install": [
      {
        "action": "mkdir",
        "path": "{dir}/logs"
      },
      {
        "action": "mkdir",
        "path": "{dir}/www"
      },
      {
        "action": "mkdir",
        "path": "{dir}/sites"
      },
      {
        "action": "mkdir",
        "path": "{dir}/temp/client_body_temp"
      },
      {
        "action": "mkdir",
        "path": "{dir}/temp/proxy_temp"
      },
      {
        "action": "mkdir",
        "path": "{dir}/temp/fastcgi_temp"
      },
      {
        "action": "mkdir",
        "path": "{dir}/temp/uwsgi_temp"
      },
      {
        "action": "mkdir",
        "path": "{dir}/temp/scgi_temp"
      },
      {
        "action": "write",
        "dst": "{dir}/nginx.conf",
        "from": "worker_processes {set:nginx.worker_processes};\n# reload 后旧 worker 最多 2s 退出：Windows 下旧 worker 会继续接新连接，\n# 不设上限时\"改完配置刷新还是旧行为\"会持续很久\nworker_shutdown_timeout 2s;\npid \"{dir}/logs/nginx.pid\";\nerror_log \"{dir}/logs/error.log\" {set:nginx.error_log_level};\n\nevents {\n    worker_connections {set:nginx.worker_connections};\n}\n\nhttp {\n    server_names_hash_bucket_size {set:nginx.server_names_hash};\n\n    # MIME 表取自运行时自带 conf/mime.types（否则 css/js/图片类型全错）\n    include \"{runtime}/conf/mime.types\";\n    default_type application/octet-stream;\n\n    # 响应编码固定 UTF-8：不写这一行，中文页面会被浏览器按 GBK 猜成乱码\n    charset utf-8;\n\n    access_log \"{dir}/logs/access.log\";\n    client_body_temp_path \"{dir}/temp/client_body_temp\";\n    proxy_temp_path \"{dir}/temp/proxy_temp\";\n    fastcgi_temp_path \"{dir}/temp/fastcgi_temp\";\n    uwsgi_temp_path \"{dir}/temp/uwsgi_temp\";\n    scgi_temp_path \"{dir}/temp/scgi_temp\";\n\n    client_max_body_size {set:nginx.client_max_body_size}m;\n    keepalive_timeout {set:nginx.keepalive_timeout}s;\n    keepalive_requests {set:nginx.keepalive_requests};\n    sendfile {setonoff:nginx.sendfile};\n    tcp_nopush {setonoff:nginx.tcp_nopush};\n    tcp_nodelay {setonoff:nginx.tcp_nodelay};\n    reset_timedout_connection {setonoff:nginx.reset_timedout};\n\n    include \"{dir}/sites/*.conf\";\n\n    server {\n        listen {port:http};\n        server_name localhost;\n        charset utf-8;\n        location / {\n            root \"{dir}/www\";\n            index {set:nginx.index};\n        }\n    }\n}\n"
      },
      {
        "action": "write",
        "dst": "{dir}/www/index.html",
        "from": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>对号 · Nginx</title>\n<style>\n  body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;\n       font-family:\"Segoe UI\",\"Microsoft YaHei\",system-ui,sans-serif;\n       background:linear-gradient(160deg,#1a1016,#241319);color:#f3e9ee}\n  .card{padding:2.25rem 2.75rem;border-radius:14px;background:#241a20;\n        border:1px solid #3a2a33;box-shadow:0 12px 40px rgba(0,0,0,.4)}\n  h1{margin:0 0 .625rem;font-size:1.125rem;font-weight:600;color:#F5133C}\n  p{margin:.25rem 0;font-size:.8125rem;line-height:1.7;color:#c9b6c1}\n  code{color:#E01A83;font-size:.8125rem}\n</style>\n</head>\n<body>\n<div class=\"card\">\n  <h1>对号 · Nginx 已就绪</h1>\n  <p>监听端口 <code>{port:http}</code></p>\n  <p>默认根目录 <code>{dir}/www</code></p>\n  <p>站点请到「网站」面板添加，每个站点独立端口。</p>\n</div>\n</body>\n</html>\n"
      }
    ]
  },
  "start": {
    "args": [
      "-p",
      "{dir}",
      "-c",
      "nginx.conf"
    ]
  },
  "config": {
    "main": "nginx.conf",
    "includeDir": "sites",
    "reload": {
      "cmd": "{bin}",
      "args": [
        "-p",
        "{dir}",
        "-c",
        "nginx.conf",
        "-s",
        "reload"
      ]
    },
    "signature": "2026-11-03-quote-paths",
    "reloadSettleMs": 600
  },
  "stop": {
    "type": "cmd",
    "cmd": "{bin}",
    "args": [
      "-p",
      "{dir}",
      "-c",
      "nginx.conf",
      "-s",
      "stop"
    ],
    "graceful": 5
  },
  "health": {
    "type": "tcp",
    "target": "127.0.0.1:{port:http}",
    "interval": 10
  },
  "settings": {
    "configFile": "nginx.conf",
    "restart": false,
    "groups": [
      {
        "title": "基本配置",
        "fields": [
          {
            "key": "nginx.port",
            "label": "启动端口",
            "type": "number",
            "default": "80",
            "portRole": "http",
            "min": 1,
            "max": 65535
          },
          {
            "key": "nginx.index",
            "label": "网站首页",
            "type": "text",
            "default": "index.html index.htm",
            "placeholder": "index.php index.html"
          },
          {
            "key": "nginx.error_log_level",
            "label": "日志级别",
            "type": "select",
            "default": "error",
            "options": [
              "debug",
              "info",
              "notice",
              "warn",
              "error",
              "crit"
            ]
          },
          {
            "key": "nginx.server_names_hash",
            "label": "域名长度",
            "type": "number",
            "default": "256",
            "unit": "b",
            "hint": "server_name 总长度过大时调大"
          }
        ]
      },
      {
        "title": "性能配置",
        "fields": [
          {
            "key": "nginx.worker_processes",
            "label": "工作进程",
            "type": "number",
            "default": "4",
            "min": 1,
            "max": 64,
            "unit": "个"
          },
          {
            "key": "nginx.worker_connections",
            "label": "并发连接",
            "type": "number",
            "default": "4096",
            "min": 64,
            "max": 100000,
            "unit": "个"
          },
          {
            "key": "nginx.client_max_body_size",
            "label": "请求大小",
            "type": "number",
            "default": "50",
            "min": 1,
            "max": 4096,
            "unit": "M"
          },
          {
            "key": "nginx.keepalive_timeout",
            "label": "长连接超时",
            "type": "number",
            "default": "65",
            "min": 1,
            "max": 600,
            "unit": "秒"
          },
          {
            "key": "nginx.keepalive_requests",
            "label": "长连接次数",
            "type": "number",
            "default": "100",
            "min": 1,
            "max": 10000,
            "unit": "次"
          },
          {
            "key": "nginx.sendfile",
            "label": "发送文件",
            "type": "switch",
            "default": "1"
          },
          {
            "key": "nginx.tcp_nopush",
            "label": "tcp_nopush",
            "type": "switch",
            "default": "0"
          },
          {
            "key": "nginx.tcp_nodelay",
            "label": "tcp_nodelay",
            "type": "switch",
            "default": "1"
          },
          {
            "key": "nginx.reset_timedout",
            "label": "重置连接",
            "type": "switch",
            "default": "1"
          }
        ]
      }
    ]
  }
}
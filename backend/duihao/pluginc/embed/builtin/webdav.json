{
  "schemaVersion": 2,
  "id": "webdav",
  "name": "WebDAV 网盘",
  "category": "transfer",
  "kind": "embedded",
  "description": "内置 WebDAV 网盘（Go 实现，BSD-3：x/net/webdav）。把本机目录变成任意设备可挂载的盘：Windows 资源管理器、RaiDrive、手机 ES 文件管理器、浏览器都走标准协议。每个共享 = 一套账号密码 + 一个根目录，默认仅监听 127.0.0.1。",
  "homepage": "https://pkg.go.dev/golang.org/x/net/webdav",
  "license": "BSD-3-Clause",
  "requires": {
    "runlib": [],
    "host": []
  },
  "ports": [
    {
      "name": "dav",
      "pool": "misc",
      "default": 9111
    }
  ],
  "workers": 0,
  "lifecycle": {
    "install": [
      {
        "action": "mkdir",
        "path": "{dir}/www"
      }
    ]
  },
  "settings": {
    "restart": true,
    "groups": [
      {
        "title": "基本配置",
        "fields": [
          {
            "key": "dav.bind",
            "label": "监听地址",
            "type": "select",
            "default": "127.0.0.1",
            "options": [
              "127.0.0.1",
              "0.0.0.0"
            ],
            "hint": "127.0.0.1 = 只有本机可挂载；0.0.0.0 = 局域网设备可挂载（必须同时开启 TLS，WebDAV 用 Basic Auth，明文 HTTP 会把密码暴露给同网段）"
          },
          {
            "key": "dav.port",
            "label": "端口",
            "type": "number",
            "default": "9111",
            "min": 1,
            "max": 65535,
            "portRole": "dav",
            "hint": "默认 9111，分配失败自动在 9100-9199 池内另选"
          },
          {
            "key": "dav.tls",
            "label": "HTTPS（自签证书）",
            "type": "switch",
            "default": "0",
            "hint": "局域网挂载必须开启；自签证书首次连接时客户端会提示一次不受信任，属正常现象"
          },
          {
            "key": "dav.readonly",
            "label": "全局只读",
            "type": "switch",
            "default": "0",
            "hint": "开启后所有共享都只能下载，禁止上传 / 改名 / 删除（共享自身的只读位与此项 OR）"
          }
        ]
      },
      {
        "title": "资源保护",
        "fields": [
          {
            "key": "dav.maxconn",
            "label": "并发连接上限",
            "type": "number",
            "default": "32",
            "min": 2,
            "max": 512,
            "hint": "同时打开的 TCP 连接数上限，超出的直接拒绝"
          },
          {
            "key": "dav.maxbody_mb",
            "label": "单文件大小上限",
            "type": "number",
            "default": "1024",
            "unit": "MB",
            "min": 1,
            "max": 65536,
            "hint": "单个上传请求的体积上限，防止一次拖入超大文件占满磁盘"
          }
        ]
      }
    ]
  },
  "manage": {
    "panel": "webdav"
  },
  "ui": {
    "home": {
      "component": "home",
      "title": "对号网盘",
      "order": 10
    }
  }
}
